# Brain/Core settings
BRAIN_LOG_LEVEL=INFO
BRAIN_TRANSPORT=mock
BRAIN_MEMORY_DB_PATH=./data/brain.sqlite
BRAIN_SETTINGS_PATH=./data/robot_settings.json
BRAIN_MOTION_LOG_PATH=./data/motion_commands.jsonl

# ESP32 Communication
BRAIN_ESP32_TCP_HOST=127.0.0.1
BRAIN_ESP32_TCP_PORT=8765
BRAIN_ESP32_SERIAL_PORT=
BRAIN_ESP32_SERIAL_BAUD=115200

# Wake-word and language
BRAIN_WAKE_WORD=aria
BRAIN_SLEEP_TIMEOUT_S=20
BRAIN_ROBOT_LANGUAGE=ar-EG

# VOSK (Speech-to-text)
BRAIN_VOSK_MODEL_PATH=./models/vosk/<model-name>
BRAIN_STT_PROVIDER=vosk
BRAIN_STT_ONLINE=false

# TTS (Text-to-speech)
BRAIN_TTS_PROVIDER=pyttsx3
BRAIN_TTS_VOICE_GENDER=female
BRAIN_TTS_CACHE_DIR=./data/tts_cache
BRAIN_TTS_ONLINE=true

# LLM Providers
BRAIN_OLLAMA_BASE_URL=http://127.0.0.1:11434
BRAIN_OLLAMA_MODEL=
BRAIN_OLLAMA_CLOUD_URL=
BRAIN_OLLAMA_CLOUD_MODEL=

# VLM Providers (Vision)
BRAIN_VLM_BASE_URL=http://127.0.0.1:11434
BRAIN_VLM_MODEL=qwen2-vl:latest
BRAIN_VLM_CLOUD_URL=
BRAIN_VLM_CLOUD_MODEL=
BRAIN_VLM_ONLINE=false
BRAIN_VLM_DEVICE=gpu
OPENAI_API_KEY=
BRAIN_OPENAI_MODEL=gpt-4o-mini
BRAIN_OPENAI_BASE_URL=https://api.openai.com/v1
GOOGLE_API_KEY=

# Web UI specific
VITE_LOCAL_ONLY=1
ROBOT_SETTINGS_PIN=1234
